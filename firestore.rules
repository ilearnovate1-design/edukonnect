rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Core Identity, Membership & Tenant Verification Helpers
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function strLower(val) {
      return val is string ? val.lower() : '';
    }

    function isNonEmptyId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidTenantSchoolId(id) {
      return isNonEmptyId(id) && strLower(id) != 'default';
    }

    function userEmailLower() {
      return isAuthenticated() &&
        request.auth.token != null &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string
          ? request.auth.token.email.lower()
          : '';
    }

    function isSuperAdminEmail() {
      return isAuthenticated() && (
        userEmailLower() == 'ilearnovate1@gmail.com' ||
        userEmailLower() == 'admin@edukonnect.ng'
      );
    }

    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        (userExists() && (
          getUserData().get('isSuperAdmin', false) == true ||
          getUserData().get('role', '') == 'SUPER_ADMIN'
        ))
      );
    }

    function isMembershipDataActive(schoolId, mData) {
      return mData.get('userId', '') == request.auth.uid &&
        strLower(mData.get('schoolId', '')) == strLower(schoolId) &&
        mData.get('status', '') == 'ACTIVE';
    }

    function hasActiveMembership(schoolId) {
      return isAuthenticated() &&
        isValidTenantSchoolId(schoolId) &&
        exists(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid)) &&
        isMembershipDataActive(
          schoolId,
          get(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid)).data
        );
    }

    function getMembership(schoolId) {
      return get(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid)).data;
    }

    function isSchoolAdmin(schoolId) {
      return isSuperAdmin() || (
        hasActiveMembership(schoolId) &&
        getMembership(schoolId).get('role', '') == 'ADMIN'
      );
    }

    function isSchoolTeacher(schoolId) {
      return hasActiveMembership(schoolId) &&
        getMembership(schoolId).get('role', '') == 'TEACHER';
    }

    function isSchoolParent(schoolId) {
      return hasActiveMembership(schoolId) &&
        getMembership(schoolId).get('role', '') == 'PARENT';
    }

    function isSchoolStaff(schoolId) {
      return isSuperAdmin() || isSchoolAdmin(schoolId) || isSchoolTeacher(schoolId);
    }

    function isSchoolMember(schoolId) {
      return isSuperAdmin() || hasActiveMembership(schoolId);
    }

    function docMatchesTenant(data) {
      return isSuperAdmin() || (
        ('schoolId' in data) &&
        isSchoolMember(data.schoolId)
      );
    }

    function canCreateInTenant() {
      return isSuperAdmin() || (
        ('schoolId' in request.resource.data) &&
        isSchoolMember(request.resource.data.schoolId)
      );
    }

    function canCreateAsSchoolAdmin() {
      return isSuperAdmin() || (
        ('schoolId' in request.resource.data) &&
        isSchoolAdmin(request.resource.data.schoolId)
      );
    }

    function canUpdateAsSchoolAdmin() {
      return isSuperAdmin() || (
        ('schoolId' in resource.data) &&
        ('schoolId' in request.resource.data) &&
        isSchoolAdmin(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId
      );
    }

    function canDeleteAsSchoolAdmin() {
      return isSuperAdmin() || (
        ('schoolId' in resource.data) &&
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    function canUpdateInTenantStaff() {
      return isSuperAdmin() || (
        ('schoolId' in resource.data) &&
        ('schoolId' in request.resource.data) &&
        isSchoolStaff(resource.data.schoolId) &&
        request.resource.data.schoolId == resource.data.schoolId
      );
    }

    // Teacher & Class/Subject Authorization Helpers
    // (Strict guard order: verify existence BEFORE reading .data; zero eager get() traps)
    function resolveMembershipTeacherId(schoolId) {
      return (hasActiveMembership(schoolId) &&
        getMembership(schoolId).get('teacherId', '') is string &&
        getMembership(schoolId).get('teacherId', '') != '')
        ? getMembership(schoolId).get('teacherId', '')
        : (userExists() && getUserData().get('teacherId', '') is string
            ? getUserData().get('teacherId', '')
            : '');
    }

    function isTeacherDataOwnedByAuth(schoolId, tData) {
      return strLower(tData.get('schoolId', '')) == strLower(schoolId) &&
        tData.get('status', 'ACTIVE') != 'INACTIVE' &&
        (
          tData.get('userId', '') == request.auth.uid ||
          (userEmailLower() != '' && strLower(tData.get('email', '')) == userEmailLower())
        );
    }

    function isTeacherDocValidForUser(schoolId, tid) {
      return isNonEmptyId(tid) &&
        exists(/databases/$(database)/documents/teachers/$(tid)) &&
        isTeacherDataOwnedByAuth(schoolId, get(/databases/$(database)/documents/teachers/$(tid)).data);
    }

    function isVerifiedActiveTeacher(schoolId) {
      return isSchoolTeacher(schoolId) &&
        isTeacherDocValidForUser(schoolId, resolveMembershipTeacherId(schoolId));
    }

    function checkTeacherClassAuthData(schoolId, tid, classId, tData, cData) {
      return strLower(cData.get('schoolId', '')) == strLower(schoolId) &&
        (
          (tData.get('assignedClassIds', []) is list && classId in tData.get('assignedClassIds', [])) ||
          cData.get('classTeacherId', '') == tid ||
          cData.get('classTeacherId', '') == request.auth.uid
        );
    }

    function isTeacherAuthorizedForClassWithTid(schoolId, tid, classId) {
      return isNonEmptyId(tid) &&
        isNonEmptyId(classId) &&
        exists(/databases/$(database)/documents/teachers/$(tid)) &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        checkTeacherClassAuthData(
          schoolId,
          tid,
          classId,
          get(/databases/$(database)/documents/teachers/$(tid)).data,
          get(/databases/$(database)/documents/classes/$(classId)).data
        );
    }

    function isTeacherAuthorizedForClass(schoolId, classId) {
      return isVerifiedActiveTeacher(schoolId) &&
        isTeacherAuthorizedForClassWithTid(schoolId, resolveMembershipTeacherId(schoolId), classId);
    }

    function checkTeacherSubjectAllowed(tData, subjectId, sData) {
      return !('subjects' in tData) ||
        tData.subjects == null ||
        (tData.subjects is list && (
          tData.subjects.size() == 0 ||
          subjectId in tData.subjects ||
          (sData.get('name', '') is string && sData.get('name', '') in tData.subjects)
        ));
    }

    function checkTeacherReportAuthData(schoolId, tid, classId, subjectId, tData, cData, sData) {
      return checkTeacherClassAuthData(schoolId, tid, classId, tData, cData) &&
        strLower(sData.get('schoolId', '')) == strLower(schoolId) &&
        checkTeacherSubjectAllowed(tData, subjectId, sData);
    }

    function isTeacherAuthorizedForReportWithTid(schoolId, tid, classId, subjectId) {
      return isNonEmptyId(tid) &&
        isNonEmptyId(classId) &&
        isNonEmptyId(subjectId) &&
        exists(/databases/$(database)/documents/teachers/$(tid)) &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        exists(/databases/$(database)/documents/subjects/$(subjectId)) &&
        checkTeacherReportAuthData(
          schoolId,
          tid,
          classId,
          subjectId,
          get(/databases/$(database)/documents/teachers/$(tid)).data,
          get(/databases/$(database)/documents/classes/$(classId)).data,
          get(/databases/$(database)/documents/subjects/$(subjectId)).data
        );
    }

    function isTeacherAuthorizedForReport(schoolId, classId, subjectId) {
      return isVerifiedActiveTeacher(schoolId) &&
        isTeacherAuthorizedForReportWithTid(schoolId, resolveMembershipTeacherId(schoolId), classId, subjectId);
    }

    function isResultLockedDoc(data) {
      return data.get('isLocked', false) == true ||
        data.get('locked', false) == true ||
        !(data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED']);
    }

    function isAdminValidReportRefs(schoolId, classId, subjectId) {
      return isNonEmptyId(classId) &&
        isNonEmptyId(subjectId) &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        strLower(get(/databases/$(database)/documents/classes/$(classId)).data.get('schoolId', '')) == strLower(schoolId) &&
        exists(/databases/$(database)/documents/subjects/$(subjectId)) &&
        strLower(get(/databases/$(database)/documents/subjects/$(subjectId)).data.get('schoolId', '')) == strLower(schoolId);
    }

    function isAuthorizedNewSchoolMembership(schoolId, userId, role) {
      return request.auth.uid == userId &&
        role == 'ADMIN' &&
        !exists(/databases/$(database)/documents/schools/$(schoolId)) &&
        existsAfter(/databases/$(database)/documents/schools/$(schoolId));
    }

    function checkInvitationDataMatch(schoolId, role, invData) {
      return strLower(invData.get('schoolId', '')) == strLower(schoolId) &&
        invData.get('role', '') == role &&
        invData.get('status', '') == 'PENDING' &&
        userEmailLower() != '' &&
        strLower(invData.get('email', '')) == userEmailLower();
    }

    function isAuthorizedInvitationMembership(schoolId, userId, role) {
      return request.auth.uid == userId &&
        isNonEmptyId(request.resource.data.get('invitationId', '')) &&
        exists(/databases/$(database)/documents/invitations/$(request.resource.data.get('invitationId', ''))) &&
        checkInvitationDataMatch(
          schoolId,
          role,
          get(/databases/$(database)/documents/invitations/$(request.resource.data.get('invitationId', ''))).data
        );
    }

    function isAuthorizedLegacyTeacherMembership(schoolId, userId, role) {
      return request.auth.uid == userId &&
        role == 'TEACHER' &&
        isNonEmptyId(request.resource.data.get('teacherId', '')) &&
        exists(/databases/$(database)/documents/teachers/$(request.resource.data.get('teacherId', ''))) &&
        isTeacherDataOwnedByAuth(
          schoolId,
          get(/databases/$(database)/documents/teachers/$(request.resource.data.get('teacherId', ''))).data
        );
    }

    function isParentDataOwnedByAuth(schoolId, pData) {
      return strLower(pData.get('schoolId', '')) == strLower(schoolId) &&
        pData.get('status', 'ACTIVE') != 'INACTIVE' &&
        (
          pData.get('userId', '') == request.auth.uid ||
          (userEmailLower() != '' && strLower(pData.get('email', '')) == userEmailLower())
        );
    }

    function isAuthorizedLegacyParentMembership(schoolId, userId, role) {
      return request.auth.uid == userId &&
        role == 'PARENT' &&
        isNonEmptyId(request.resource.data.get('parentId', '')) &&
        exists(/databases/$(database)/documents/parents/$(request.resource.data.get('parentId', ''))) &&
        isParentDataOwnedByAuth(
          schoolId,
          get(/databases/$(database)/documents/parents/$(request.resource.data.get('parentId', ''))).data
        );
    }

    function isAuthorizedLegacyAdminMembership(schoolId, userId, role) {
      return request.auth.uid == userId &&
        role == 'ADMIN' &&
        userExists() &&
        getUserData().get('role', '') == 'ADMIN' &&
        strLower(getUserData().get('schoolId', '')) == strLower(schoolId);
    }

    function isMembershipOwnerForSelfHeal(mData) {
      return mData.get('userId', '') == request.auth.uid || (
        (mData.get('userId', '') == '' || mData.get('userId', '') == null) &&
        userEmailLower() != '' &&
        strLower(mData.get('userEmail', '')) == userEmailLower()
      );
    }

    // =========================================================================
    // Platform Level Access (Super Admin Only)
    // =========================================================================
    match /platformUsage/{date} {
      allow read, write: if isSuperAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isSuperAdmin();
      }
    }
    match /platformSettings/{id} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 1. Schools, Domains, Invitations & Memberships
    // =========================================================================
    match /schools/{schoolId} {
      allow get: if isValidTenantSchoolId(schoolId) || isSuperAdmin();
      allow list: if isSuperAdmin() || (('schoolId' in resource.data) && isSchoolMember(resource.data.schoolId));
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          isValidTenantSchoolId(schoolId) &&
          !exists(/databases/$(database)/documents/schools/$(schoolId)) &&
          request.resource.data.get('schoolId', '') == schoolId &&
          existsAfter(/databases/$(database)/documents/memberships/$(schoolId + '_' + request.auth.uid))
        )
      );
      allow update: if isAuthenticated() && isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
    }

    match /schoolSettings/{docId} {
      allow get: if isNonEmptyId(docId);
      allow list: if isSuperAdmin() || (('schoolId' in resource.data) && isSchoolMember(resource.data.schoolId));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        isSchoolAdmin(docId)
      );
      allow delete: if isSuperAdmin() || isSchoolAdmin(docId);
    }

    match /schoolDomains/{domain} {
      allow get: if isNonEmptyId(domain);
      allow list: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
      );
      allow create: if isSuperAdmin() || (
        ('schoolId' in request.resource.data) && isSchoolAdmin(request.resource.data.schoolId)
      );
      allow update, delete: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
      );
    }

    match /invitations/{invitationId} {
      // Single-code lookup during registration; never public list
      allow get: if isNonEmptyId(invitationId);
      allow list: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
      );
      allow create: if isSuperAdmin() || (
        ('schoolId' in request.resource.data) &&
        isSchoolAdmin(request.resource.data.schoolId) &&
        request.resource.data.get('status', '') == 'PENDING' &&
        request.resource.data.get('role', '') in ['TEACHER', 'PARENT']
      );
      allow update: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId) &&
        request.resource.data.get('schoolId', '') == resource.data.schoolId
      ) || (
        isAuthenticated() &&
        resource.data.get('status', '') == 'PENDING' &&
        request.resource.data.get('status', '') == 'ACCEPTED' &&
        request.resource.data.get('acceptedBy', '') == request.auth.uid &&
        userEmailLower() != '' &&
        strLower(resource.data.get('email', '')) == userEmailLower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy', 'updatedAt'])
      );
      allow delete: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
      );
    }

    match /memberships/{membershipId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        (userEmailLower() != '' && strLower(resource.data.get('userEmail', '')) == userEmailLower()) ||
        (('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId))
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (userEmailLower() != '' && resource.data.userEmail == userEmailLower()) ||
        (('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          isValidTenantSchoolId(request.resource.data.get('schoolId', '')) &&
          isNonEmptyId(request.resource.data.get('userId', '')) &&
          membershipId == request.resource.data.schoolId + '_' + request.resource.data.userId &&
          request.resource.data.get('role', '') in ['ADMIN', 'TEACHER', 'PARENT'] &&
          request.resource.data.get('status', '') in ['ACTIVE', 'INVITED', 'SUSPENDED', 'REVOKED'] && (
            isSchoolAdmin(request.resource.data.schoolId) || (
              request.resource.data.get('status', '') == 'ACTIVE' && (
                isAuthorizedNewSchoolMembership(request.resource.data.schoolId, request.resource.data.userId, request.resource.data.role) ||
                isAuthorizedInvitationMembership(request.resource.data.schoolId, request.resource.data.userId, request.resource.data.role) ||
                isAuthorizedLegacyTeacherMembership(request.resource.data.schoolId, request.resource.data.userId, request.resource.data.role) ||
                isAuthorizedLegacyParentMembership(request.resource.data.schoolId, request.resource.data.userId, request.resource.data.role) ||
                isAuthorizedLegacyAdminMembership(request.resource.data.schoolId, request.resource.data.userId, request.resource.data.role)
              )
            )
          )
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          isSchoolAdmin(resource.data.schoolId) &&
          request.resource.data.get('schoolId', '') == resource.data.schoolId &&
          request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
          request.resource.data.get('role', '') in ['ADMIN', 'TEACHER', 'PARENT']
        ) || (
          // Self-healing link backfill ONLY: role, status, and schoolId remain strictly immutable
          ('schoolId' in resource.data) &&
          isValidTenantSchoolId(resource.data.schoolId) &&
          membershipId == strLower(resource.data.schoolId) + '_' + request.auth.uid &&
          isMembershipOwnerForSelfHeal(resource.data) &&
          resource.data.get('status', '') == 'ACTIVE' &&
          request.resource.data.get('schoolId', '') == resource.data.schoolId &&
          request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.get('status', '') == resource.data.get('status', '') && (
            (
              resource.data.get('role', '') == 'TEACHER' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'teacherId', 'updatedAt']) &&
              isAuthorizedLegacyTeacherMembership(resource.data.schoolId, request.auth.uid, 'TEACHER')
            ) || (
              resource.data.get('role', '') == 'PARENT' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'parentId', 'updatedAt']) &&
              isAuthorizedLegacyParentMembership(resource.data.schoolId, request.auth.uid, 'PARENT')
            )
          )
        )
      );
      allow delete: if isSuperAdmin() || (
        ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
      );
    }

    // =========================================================================
    // 2. User Accounts & Identity Protection
    // =========================================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        (('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId))
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.get('isSuperAdmin', false) == false &&
          request.resource.data.get('role', 'PARENT') in ['TEACHER', 'PARENT', 'ADMIN'] && (
            !isValidTenantSchoolId(request.resource.data.get('schoolId', '')) ||
            hasActiveMembership(request.resource.data.get('schoolId', '')) ||
            existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '') + '_' + request.auth.uid))
          )
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          // School Admins can manage users within their verified school
          ('schoolId' in resource.data) &&
          isSchoolAdmin(resource.data.schoolId) &&
          request.resource.data.get('schoolId', '') == resource.data.schoolId &&
          resource.data.get('role', '') != 'SUPER_ADMIN' &&
          request.resource.data.get('role', '') != 'SUPER_ADMIN' &&
          request.resource.data.get('isSuperAdmin', false) == false
        ) || (
          // Self-updates cannot escalate role/privileges; school/role sync must match an active membership
          request.auth.uid == userId &&
          request.resource.data.get('isSuperAdmin', false) == false &&
          request.resource.data.get('role', '') != 'SUPER_ADMIN' && (
            (
              request.resource.data.get('role', '') == resource.data.get('role', '') &&
              request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
              request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '') &&
              request.resource.data.get('teacherId', '') == resource.data.get('teacherId', '') &&
              request.resource.data.get('parentId', '') == resource.data.get('parentId', '')
            ) || (
              isValidTenantSchoolId(request.resource.data.get('schoolId', '')) &&
              (
                hasActiveMembership(request.resource.data.schoolId) ||
                existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.schoolId + '_' + request.auth.uid))
              ) &&
              request.resource.data.get('role', '') == (
                hasActiveMembership(request.resource.data.schoolId)
                  ? getMembership(request.resource.data.schoolId).get('role', '')
                  : getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.schoolId + '_' + request.auth.uid)).data.get('role', '')
              ) &&
              request.resource.data.get('approvalStatus', 'APPROVED') == 'APPROVED'
            )
          )
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          isSchoolAdmin(resource.data.schoolId) &&
          resource.data.get('role', '') != 'SUPER_ADMIN' &&
          resource.data.get('isSuperAdmin', false) != true
        )
      );
    }

    // =========================================================================
    // 3. Students, Parents, Teachers, Classes & Subjects
    // =========================================================================
    match /students/{studentId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) && (
            isSchoolStaff(resource.data.schoolId) || (
              isSchoolParent(resource.data.schoolId) && (
                (getMembership(resource.data.schoolId).get('parentId', '') != '' &&
                  getMembership(resource.data.schoolId).get('parentId', '') in resource.data.get('parentIds', [])) ||
                (userEmailLower() != '' && userEmailLower() in resource.data.get('parentEmails', []))
              )
            )
          )
        )
      );
      allow list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin() || (
        isAuthenticated() &&
        ('schoolId' in resource.data) &&
        isValidTenantSchoolId(resource.data.schoolId) &&
        request.resource.data.get('schoolId', '') == resource.data.schoolId &&
        existsAfter(/databases/$(database)/documents/memberships/$(resource.data.schoolId + '_' + request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds', 'parentEmails', 'updatedAt'])
      );
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /parents/{parentId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) && (
            isSchoolStaff(resource.data.schoolId) || (
              isSchoolParent(resource.data.schoolId) && (
                resource.data.get('userId', '') == request.auth.uid ||
                (userEmailLower() != '' && strLower(resource.data.get('email', '')) == userEmailLower())
              )
            )
          )
        )
      );
      allow list: if isAuthenticated() && (
        docMatchesTenant(resource.data) ||
        resource.data.userId == request.auth.uid ||
        (userEmailLower() != '' && resource.data.email == userEmailLower())
      );
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin() || (
        isAuthenticated() &&
        ('schoolId' in resource.data) &&
        isValidTenantSchoolId(resource.data.schoolId) &&
        request.resource.data.get('schoolId', '') == resource.data.schoolId &&
        userEmailLower() != '' &&
        strLower(resource.data.get('email', '')) == userEmailLower() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        (
          hasActiveMembership(resource.data.schoolId) ||
          existsAfter(/databases/$(database)/documents/memberships/$(resource.data.schoolId + '_' + request.auth.uid))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt'])
      );
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /teachers/{teacherId} {
      allow get: if isAuthenticated() && (
        docMatchesTenant(resource.data) ||
        resource.data.get('userId', '') == request.auth.uid ||
        (userEmailLower() != '' && strLower(resource.data.get('email', '')) == userEmailLower())
      );
      allow list: if isAuthenticated() && (
        docMatchesTenant(resource.data) ||
        resource.data.userId == request.auth.uid ||
        (userEmailLower() != '' && resource.data.email == userEmailLower())
      );
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin() || (
        isAuthenticated() &&
        ('schoolId' in resource.data) &&
        isValidTenantSchoolId(resource.data.schoolId) &&
        request.resource.data.get('schoolId', '') == resource.data.schoolId &&
        userEmailLower() != '' &&
        strLower(resource.data.get('email', '')) == userEmailLower() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        (
          hasActiveMembership(resource.data.schoolId) ||
          existsAfter(/databases/$(database)/documents/memberships/$(resource.data.schoolId + '_' + request.auth.uid))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'status', 'updatedAt'])
      );
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /classes/{classId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin();
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /subjects/{subjectId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin();
      allow delete: if canDeleteAsSchoolAdmin();
    }

    // =========================================================================
    // 4. Attendance, Fees & Payments
    // =========================================================================
    match /attendance/{attendanceId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in request.resource.data) &&
          isSchoolStaff(request.resource.data.schoolId)
        )
      );
      allow update: if isAuthenticated() && canUpdateInTenantStaff();
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /feeStructures/{feeStructureId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin() &&
        'amount' in request.resource.data &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if canUpdateAsSchoolAdmin() &&
        'amount' in request.resource.data &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin() &&
        'amount' in request.resource.data &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if canUpdateAsSchoolAdmin() &&
        'amount' in request.resource.data &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow delete: if canDeleteAsSchoolAdmin();
    }

    // =========================================================================
    // 5. Student Academic Reports (Results), Grading Profiles & Evaluations
    // =========================================================================
    match /results/{resultId} {
      allow get, list: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          isValidTenantSchoolId(resource.data.schoolId) && (
            isSchoolStaff(resource.data.schoolId) || (
              isSchoolParent(resource.data.schoolId) &&
              resource.data.status == 'PUBLISHED'
            )
          )
        )
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in request.resource.data) &&
          isValidTenantSchoolId(request.resource.data.schoolId) &&
          isNonEmptyId(request.resource.data.get('studentId', '')) &&
          isNonEmptyId(request.resource.data.get('classId', '')) &&
          isNonEmptyId(request.resource.data.get('subjectId', '')) &&
          isNonEmptyId(request.resource.data.get('academicSession', '')) &&
          isNonEmptyId(request.resource.data.get('term', '')) && (
            (
              isSchoolAdmin(request.resource.data.schoolId) &&
              isAdminValidReportRefs(
                request.resource.data.schoolId,
                request.resource.data.classId,
                request.resource.data.subjectId
              ) &&
              request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED', 'APPROVED', 'PUBLISHED']
            ) || (
              isTeacherAuthorizedForReport(
                request.resource.data.schoolId,
                request.resource.data.classId,
                request.resource.data.subjectId
              ) &&
              request.resource.data.get('teacherId', '') == request.auth.uid &&
              request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED'] &&
              request.resource.data.get('isLocked', false) == false &&
              request.resource.data.get('locked', false) == false &&
              !('approvedBy' in request.resource.data) &&
              !('approvedAt' in request.resource.data) &&
              !('publishedBy' in request.resource.data) &&
              !('publishedAt' in request.resource.data) &&
              !('lockedBy' in request.resource.data) &&
              !('lockedAt' in request.resource.data) &&
              (
                request.resource.data.get('status', 'DRAFT') != 'SUBMITTED' ||
                request.resource.data.get('submittedBy', '') == request.auth.uid
              )
            )
          )
        )
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          ('schoolId' in request.resource.data) &&
          isValidTenantSchoolId(resource.data.schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.get('studentId', '') == resource.data.get('studentId', '') &&
          request.resource.data.get('classId', '') == resource.data.get('classId', '') &&
          request.resource.data.get('subjectId', '') == resource.data.get('subjectId', '') &&
          request.resource.data.get('academicSession', '') == resource.data.get('academicSession', '') &&
          request.resource.data.get('term', '') == resource.data.get('term', '') && (
            (
              isSchoolAdmin(resource.data.schoolId) &&
              request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED', 'APPROVED', 'PUBLISHED']
            ) || (
              isTeacherAuthorizedForReport(
                resource.data.schoolId,
                resource.data.get('classId', ''),
                resource.data.get('subjectId', '')
              ) &&
              !isResultLockedDoc(resource.data) &&
              request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED'] &&
              request.resource.data.get('isLocked', false) == false &&
              request.resource.data.get('locked', false) == false &&
              (
                !('teacherId' in resource.data) ||
                resource.data.teacherId == null ||
                resource.data.teacherId == '' ||
                resource.data.teacherId == request.auth.uid ||
                resource.data.teacherId == resolveMembershipTeacherId(resource.data.schoolId)
              ) &&
              request.resource.data.get('teacherId', '') == request.auth.uid &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'approvedBy', 'approvedAt', 'publishedBy', 'publishedAt', 'lockedBy', 'lockedAt'
              ]) &&
              (
                request.resource.data.get('status', 'DRAFT') != 'SUBMITTED' ||
                request.resource.data.get('submittedBy', '') == request.auth.uid
              )
            )
          )
        )
      );

      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /gradingProfiles/{profileId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin();
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /evaluations/{evalId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in request.resource.data) &&
          isValidTenantSchoolId(request.resource.data.schoolId) &&
          isNonEmptyId(request.resource.data.get('studentId', '')) && (
            isSchoolAdmin(request.resource.data.schoolId) || (
              isVerifiedActiveTeacher(request.resource.data.schoolId) &&
              isTeacherAuthorizedForClass(
                request.resource.data.schoolId,
                request.resource.data.get('classId', '')
              ) &&
              !('principalRemark' in request.resource.data)
            )
          )
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          ('schoolId' in request.resource.data) &&
          isValidTenantSchoolId(resource.data.schoolId) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.get('studentId', '') == resource.data.get('studentId', '') && (
            isSchoolAdmin(resource.data.schoolId) || (
              isVerifiedActiveTeacher(resource.data.schoolId) &&
              isTeacherAuthorizedForClass(
                resource.data.schoolId,
                request.resource.data.get('classId', resource.data.get('classId', ''))
              ) &&
              request.resource.data.get('principalRemark', '') == resource.data.get('principalRemark', '')
            )
          )
        )
      );
      allow delete: if canDeleteAsSchoolAdmin();
    }

    // =========================================================================
    // 6. Homework, Submissions, Announcements, Notifications & Audit Logs
    // =========================================================================
    match /assignments/{assignmentId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in request.resource.data) &&
          isSchoolStaff(request.resource.data.schoolId)
        )
      );
      allow update: if isAuthenticated() && canUpdateInTenantStaff();
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) && isSchoolStaff(resource.data.schoolId)
        )
      );
    }

    match /submissions/{submissionId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if isAuthenticated() && canCreateInTenant() && (
        isSchoolStaff(request.resource.data.get('schoolId', '')) || (
          isSchoolParent(request.resource.data.get('schoolId', '')) &&
          request.resource.data.get('status', 'SUBMITTED') in ['NOT_SUBMITTED', 'SUBMITTED'] &&
          !('score' in request.resource.data) &&
          !('teacherComment' in request.resource.data)
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          ('schoolId' in request.resource.data) &&
          request.resource.data.schoolId == resource.data.schoolId &&
          isSchoolMember(resource.data.schoolId) && (
            isSchoolStaff(resource.data.schoolId) || (
              isSchoolParent(resource.data.schoolId) &&
              resource.data.get('status', 'NOT_SUBMITTED') != 'GRADED' &&
              request.resource.data.get('status', 'SUBMITTED') in ['NOT_SUBMITTED', 'SUBMITTED'] &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'teacherComment'])
            )
          )
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) && isSchoolStaff(resource.data.schoolId)
        )
      );
    }

    match /announcements/{announcementId} {
      allow get, list: if isAuthenticated() && docMatchesTenant(resource.data);
      allow create: if canCreateAsSchoolAdmin();
      allow update: if canUpdateAsSchoolAdmin();
      allow delete: if canDeleteAsSchoolAdmin();
    }

    match /notifications/{notificationId} {
      allow get, list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isAuthenticated() && canCreateInTenant();
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          request.resource.data.get('schoolId', '') == resource.data.schoolId &&
          isSchoolMember(resource.data.schoolId) &&
          (resource.data.get('userId', '') == request.auth.uid || isSchoolAdmin(resource.data.schoolId))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) &&
          isSchoolMember(resource.data.schoolId) &&
          (resource.data.get('userId', '') == request.auth.uid || isSchoolAdmin(resource.data.schoolId))
        )
      );
    }

    match /auditLogs/{auditId} {
      allow get, list: if isAuthenticated() && (
        isSuperAdmin() || (
          ('schoolId' in resource.data) && isSchoolAdmin(resource.data.schoolId)
        )
      );
      allow create: if isAuthenticated() && canCreateInTenant() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if false;
      allow delete: if canDeleteAsSchoolAdmin();
    }
  }
}
