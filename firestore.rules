rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Authentication & Role Validation Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdminEmail() {
      return isAuthenticated() &&
        request.auth.token != null &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == 'ilearnovate1@gmail.com' ||
          request.auth.token.email.lower() == 'admin@edukonnect.ng'
        );
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        (userExists() && (
          getUserData().get('isSuperAdmin', false) == true ||
          getUserData().get('role', '') == 'SUPER_ADMIN'
        ))
      );
    }
    
    function getUserRole() {
      return userExists() ? getUserData().get('role', '') : '';
    }

    function getUserSchoolId() {
      return userExists() ? getUserData().get('schoolId', '') : '';
    }

    function isApproved() {
      return isSuperAdmin() || (userExists() && getUserData().get('approvalStatus', 'PENDING_SETUP') == 'APPROVED');
    }

    function isApprovedOrSetup() {
      return isSuperAdmin() || (userExists() && (
        getUserData().get('approvalStatus', 'PENDING_SETUP') == 'APPROVED' ||
        getUserData().get('approvalStatus', 'PENDING_SETUP') == 'PENDING_SETUP'
      ));
    }

    // Authoritative School Membership Helpers
    function hasActiveMembership(targetSchoolId) {
      return isAuthenticated() &&
        targetSchoolId is string &&
        targetSchoolId != '' &&
        exists(/databases/$(database)/documents/memberships/$(targetSchoolId.lower() + '_' + request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(targetSchoolId.lower() + '_' + request.auth.uid)).data.get('status', '') == 'ACTIVE';
    }

    function getMembershipRole(targetSchoolId) {
      return hasActiveMembership(targetSchoolId)
        ? get(/databases/$(database)/documents/memberships/$(targetSchoolId.lower() + '_' + request.auth.uid)).data.get('role', '')
        : '';
    }

    function hasRoleInSchool(targetSchoolId, allowedRoles) {
      return isSuperAdmin() || (
        targetSchoolId is string &&
        targetSchoolId != '' && (
          (hasActiveMembership(targetSchoolId) && getMembershipRole(targetSchoolId) in allowedRoles) ||
          (isApprovedOrSetup() && getUserSchoolId().lower() == targetSchoolId.lower() && getUserRole() in allowedRoles)
        )
      );
    }

    function isTenantMember(targetSchoolId) {
      return isSuperAdmin() || (
        targetSchoolId is string &&
        targetSchoolId != '' && (
          hasActiveMembership(targetSchoolId) ||
          (isApprovedOrSetup() && getUserSchoolId().lower() == targetSchoolId.lower())
        )
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserRole() == 'ADMIN'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserRole() == 'TEACHER' ||
        getUserRole() == 'ADMIN'
      );
    }

    function isParent() {
      return isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'PARENT'
      );
    }

    // Platform level access (Super Admin only)
    match /platformUsage/{date} {
      allow read, write: if isSuperAdmin();
      match /{allSubcollections=**} {
        allow read, write: if isSuperAdmin();
      }
    }
    match /platformSettings/{id} {
      allow read, write: if isSuperAdmin();
    }

    // Multi-Tenant Isolation Helpers
    // Records must strictly match the user's verified schoolId (via active membership or user profile, case-insensitive).
    function docMatchesTenant(data) {
      return isSuperAdmin() || isTenantMember(data.get('schoolId', ''));
    }

    function canCreateInTenant() {
      return isSuperAdmin() || isTenantMember(request.resource.data.get('schoolId', ''));
    }

    function canUpdateInTenant() {
      return isSuperAdmin() || (
        isTenantMember(resource.data.get('schoolId', '')) &&
        request.resource.data.get('schoolId', '').lower() == resource.data.get('schoolId', '').lower()
      );
    }

    function canDeleteInTenant() {
      return isSuperAdmin() || isTenantMember(resource.data.get('schoolId', ''));
    }

    // 1. School Profile & Settings (Public read, Staff write)
    match /schools/{schoolId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        (isSuperAdmin() || !exists(/databases/$(database)/documents/schools/$(schoolId)));
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        hasRoleInSchool(schoolId, ['ADMIN', 'TEACHER']) ||
        ((isAdmin() || isTeacher()) && schoolId == 'default')
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && hasRoleInSchool(schoolId, ['ADMIN']) && isApproved());
    }

    // 1b. School Invitations (Expiring Single-Use Activation Tokens)
    match /invitations/{invitationId} {
      allow read: if true; // Public get to verify invitation code before or during signup
      allow list: if isAuthenticated() && (isSuperAdmin() || (isAdmin() && isApproved()));
      allow create: if isAuthenticated() && (isSuperAdmin() || (hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant()));
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && docMatchesTenant(resource.data)) ||
        (
          resource.data.get('status', '') == 'PENDING' &&
          request.resource.data.get('status', '') == 'ACCEPTED' &&
          request.resource.data.get('acceptedBy', '') == request.auth.uid &&
          request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
          request.resource.data.get('role', '') == resource.data.get('role', '') &&
          request.resource.data.get('email', '') == resource.data.get('email', '')
        )
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && docMatchesTenant(resource.data));
    }

    // 1c. School Memberships (Multi-Tenant & Multi-School Association)
    match /memberships/{membershipId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.get('userId', '') == request.auth.uid || 
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && resource.data.get('userEmail', '').lower() == request.auth.token.email.lower()) ||
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && (
          resource.data.userEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email.lower()
        )) ||
        (isAdmin() && isApproved())
      );
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() || 
        hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) || 
        (
          request.auth.uid == request.resource.data.get('userId', '') &&
          request.resource.data.get('schoolId', '') is string &&
          request.resource.data.get('schoolId', '') != '' &&
          membershipId == (request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid) &&
          request.resource.data.get('role', '') in ['ADMIN', 'TEACHER', 'PARENT'] &&
          request.resource.data.get('status', '') == 'ACTIVE' && (
            // 1. New school registration (school doc does not exist before this batch)
            (
              request.resource.data.get('role', '') == 'ADMIN' &&
              !exists(/databases/$(database)/documents/schools/$(request.resource.data.get('schoolId', '')))
            ) ||
            // 2. Activating a valid pending invitation in the same batch
            (
              'invitationId' in request.resource.data &&
              request.resource.data.invitationId is string &&
              exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('status', '') == 'ACCEPTED' &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('acceptedBy', '') == request.auth.uid &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('schoolId', '').lower() == request.resource.data.get('schoolId', '').lower() &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.get('role', '') == request.resource.data.get('role', '')
            ) ||
            // 3. Linking from an active admin-created teacher record
            (
              request.resource.data.get('role', '') == 'TEACHER' &&
              'teacherId' in request.resource.data &&
              request.resource.data.teacherId is string &&
              exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)) &&
              get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.get('schoolId', '').lower() == request.resource.data.get('schoolId', '').lower() &&
              get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.get('status', 'ACTIVE') != 'INACTIVE' && (
                get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.get('userId', '') == request.auth.uid ||
                (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.get('email', '').lower() == request.auth.token.email.lower())
              )
            ) ||
            // 4. Linking from an admin-created parent record
            (
              request.resource.data.get('role', '') == 'PARENT' &&
              'parentId' in request.resource.data &&
              request.resource.data.parentId is string &&
              exists(/databases/$(database)/documents/parents/$(request.resource.data.parentId)) &&
              get(/databases/$(database)/documents/parents/$(request.resource.data.parentId)).data.get('schoolId', '').lower() == request.resource.data.get('schoolId', '').lower() && (
                get(/databases/$(database)/documents/parents/$(request.resource.data.parentId)).data.get('userId', '') == request.auth.uid ||
                (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && get(/databases/$(database)/documents/parents/$(request.resource.data.parentId)).data.get('email', '').lower() == request.auth.token.email.lower())
              )
            )
          )
        )
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']));
    }

    match /schoolSettings/{docId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        hasRoleInSchool(docId, ['ADMIN', 'TEACHER']) ||
        ((isAdmin() || isTeacher()) && (docId == 'default' || docId == 'general'))
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && hasRoleInSchool(docId, ['ADMIN']));
    }

    match /schoolDomains/{domain} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAuthenticated() && ('schoolId' in resource.data) && hasRoleInSchool(resource.data.schoolId, ['ADMIN']));
    }

    // 2. User Accounts & Identity Protection
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid == userId ||
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        (isAdmin() && isApproved() && resource.data.schoolId == getUserSchoolId())
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.get('isSuperAdmin', false) == false &&
          request.resource.data.get('role', 'PARENT') in ['TEACHER', 'PARENT', 'ADMIN'] && (
            request.resource.data.get('schoolId', '') == '' || (
              request.resource.data.get('schoolId', '') is string &&
              existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)) &&
              getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)).data.get('status', '') == 'ACTIVE' &&
              getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)).data.get('role', '') == request.resource.data.get('role', '')
            )
          )
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (
          // School Admins can update users belonging to their own school or unassigned users being linked to their school
          hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) &&
          (resource.data.get('schoolId', '') == '' || resource.data.get('schoolId', '').lower() == request.resource.data.get('schoolId', '').lower()) &&
          resource.data.get('role', '') != 'SUPER_ADMIN' &&
          request.resource.data.get('role', '') != 'SUPER_ADMIN' &&
          request.resource.data.get('isSuperAdmin', false) == false
        ) || (
          // Users self-updating their own account CANNOT escalate privileges,
          // and may only change role/schoolId/approvalStatus to match a verified ACTIVE membership
          request.auth.uid == userId &&
          request.resource.data.get('isSuperAdmin', false) == resource.data.get('isSuperAdmin', false) &&
          request.resource.data.get('role', '') != 'SUPER_ADMIN' && (
            (
              request.resource.data.get('role', '') == resource.data.get('role', '') &&
              request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
              request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '')
            ) || (
              request.resource.data.get('schoolId', '') is string &&
              request.resource.data.get('schoolId', '') != '' &&
              existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)) &&
              getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)).data.get('status', '') == 'ACTIVE' &&
              getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + userId)).data.get('role', '') == request.resource.data.get('role', '') &&
              request.resource.data.get('approvalStatus', '') == 'APPROVED'
            )
          )
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])
      ) && resource.data.get('role', '') != 'SUPER_ADMIN' && resource.data.get('isSuperAdmin', false) != true;
    }

    // 3. Students Directory (Parents can only view their own linked children)
    match /students/{studentId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data) && (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) ||
        (hasRoleInSchool(resource.data.get('schoolId', ''), ['PARENT']) && (
          (userExists() && 'parentId' in getUserData() && getUserData().parentId in resource.data.get('parentIds', [])) ||
          (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() in resource.data.get('parentEmails', []))
        ))
      );
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant();
      allow update: if (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant()
      ) || (
        // Allow parent invitation acceptance batch to sync parentIds/parentEmails on linked students
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds', 'parentEmails', 'updatedAt']) &&
        existsAfter(/databases/$(database)/documents/memberships/$(resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/memberships/$(resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data.get('role', '') == 'PARENT' &&
        'invitationId' in getAfter(/databases/$(database)/documents/memberships/$(resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data
      );
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 4. Parents Directory (Parents can only view their own record)
    match /parents/{parentId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data) && (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) ||
        (hasRoleInSchool(resource.data.get('schoolId', ''), ['PARENT']) && (
          resource.data.get('userId', '') == request.auth.uid ||
          (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && resource.data.get('email', '').lower() == request.auth.token.email.lower())
        ))
      );
      allow list: if isAuthenticated();
      allow create: if (
        hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant()
      ) || (
        // Allow creating parent record during verified invitation acceptance batch
        isAuthenticated() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data.get('role', '') == 'PARENT' &&
        'invitationId' in getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data
      );
      allow update: if (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant()
      ) || (
        // Allow parent user to link their own userId on email-matched parent doc
        isAuthenticated() &&
        request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null &&
        resource.data.get('email', '').lower() == request.auth.token.email.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt']) &&
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 5. Teachers Directory
    match /teachers/{teacherId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if (
        hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant()
      ) || (
        // Allow creating teacher record during verified invitation acceptance batch
        isAuthenticated() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data.get('role', '') == 'TEACHER' &&
        'invitationId' in getAfter(/databases/$(database)/documents/memberships/$(request.resource.data.get('schoolId', '').lower() + '_' + request.auth.uid)).data
      );
      allow update: if (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant()
      ) || (
        // Allow active teacher user to link their own userId on email-matched teacher doc
        isAuthenticated() &&
        resource.data.get('status', 'ACTIVE') != 'INACTIVE' &&
        request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null &&
        resource.data.get('email', '').lower() == request.auth.token.email.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'status', 'updatedAt']) &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('status', 'ACTIVE') == 'ACTIVE'
      );
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 6. Classes & Grade Arms
    match /classes/{classId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant();
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 7. Academic Subjects
    match /subjects/{subjectId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant();
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 8. Daily Pupil Attendance
    match /attendance/{attendanceId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canCreateInTenant();
      allow update: if isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 9. Fee Structures & Tariffs (Bursary Schedule)
    match /feeStructures/{feeStructureId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 10. Student Fee Payments & Receipts
    match /payments/{paymentId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant() && 
        'amount' in request.resource.data && 
        request.resource.data.amount is number && 
        request.resource.data.amount > 0;
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 11. Terminal Examination & CA Results
    match /results/{resultId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data) && (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) ||
        resource.data.get('status', 'DRAFT') == 'PUBLISHED'
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) || (
          hasRoleInSchool(request.resource.data.get('schoolId', ''), ['TEACHER']) && 
          request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED']
        )
      ) && canCreateInTenant();
      allow update: if isAuthenticated() && (
        hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) || (
          hasRoleInSchool(resource.data.get('schoolId', ''), ['TEACHER']) && 
          request.resource.data.get('status', 'DRAFT') in ['DRAFT', 'SUBMITTED'] &&
          resource.data.get('status', 'DRAFT') != 'PUBLISHED'
        )
      ) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 11b. Configurable Grading Profiles & Standards
    match /gradingProfiles/{profileId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant();
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 12. Homework & Assignments
    match /assignments/{assignmentId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canCreateInTenant();
      allow update: if isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canUpdateInTenant();
      allow delete: if isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canDeleteInTenant();
    }

    // 13. Student Assignment Submissions
    match /submissions/{submissionId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateInTenant();
      allow update: if isAuthenticated() && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canDeleteInTenant();
    }

    // 14. Bulletins & Announcements
    match /announcements/{announcementId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN']) && canCreateInTenant();
      allow update: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }

    // 15. In-App Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])) && docMatchesTenant(resource.data);
      allow create: if isAuthenticated() && canCreateInTenant();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])) && canUpdateInTenant();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN'])) && canDeleteInTenant();
    }

    // 16. Security Audit Logs
    match /auditLogs/{auditId} {
      allow get: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && docMatchesTenant(resource.data);
      allow list: if isAdmin();
      allow create: if isAuthenticated() && canCreateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
      allow update: if false;
    }

    // 17. Student Terminal Evaluations & Remarks
    match /evaluations/{evalId} {
      allow get: if isAuthenticated() && docMatchesTenant(resource.data);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && hasRoleInSchool(request.resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canCreateInTenant();
      allow update: if isAuthenticated() && hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN', 'TEACHER']) && canUpdateInTenant();
      allow delete: if hasRoleInSchool(resource.data.get('schoolId', ''), ['ADMIN']) && canDeleteInTenant();
    }
  }
}
